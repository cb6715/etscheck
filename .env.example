DATABASE_URL="postgresql://user:password@localhost:5432/vagtloen?schema=public"
# På Netlify er dette ikke nødvendigt — @netlify/database provisionerer og
# sætter NETLIFY_DB_URL automatisk ved deploy.

# Påkrævet — signerer login-sessionen. Generér fx med:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Sætter hvilken bruger der altid har gratis, fuld adgang uanset abonnement.
# Brug det tal users.id har for din konto i databasen (migrationen
# 20261016090000 sætter også is_owner=true direkte på cornelius@neurix.dk,
# så dette er et uafhængigt sikkerhedsnet, ikke den eneste vej til ejerskab).
WAGEFLOW_OWNER_USER_ID=""

# Stripe — uden disse virker appen fint for ejeren, men /abonnement viser
# "betaling er endnu ikke konfigureret" for alle andre. Se opsætningstrinene
# i svaret fra Claude for hvordan Price/Webhook oprettes i Stripe Dashboard.
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""

# Appens egen URL — bruges til Stripe Checkout/Portal success- og cancel-urls.
NEXT_PUBLIC_APP_URL="https://dit-site.netlify.app"
