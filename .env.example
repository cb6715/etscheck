DATABASE_URL="postgresql://user:password@localhost:5432/arbejdsapp?schema=public"
# På Netlify kan denne udelades hvis Netlify DB (Neon) er tilknyttet siden —
# så bruges NETLIFY_DATABASE_URL automatisk i stedet (se scripts/netlify-build.mjs).

# Valgfri: sæt denne for at lade "Godmorgen-briefingen" bruge den rigtige Claude API
# til at fortolke naturligt sprog. Uden den bruges en indbygget dansk regelmotor,
# som fuldt ud forstår eksemplerne fra specifikationen.
# ANTHROPIC_API_KEY="sk-ant-..."
