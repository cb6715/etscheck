// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum Priority {
  NORMAL
  VIGTIG
  HASTER
}

enum RecurrenceType {
  DAGLIGT
  HVERDAGE
  UGEDAGE
  UGENTLIGT
  HVER_2_UGE
  MAANEDLIGT
  DATO
}

enum TrailerStatus {
  MANGLER
  I_GANG
  VASKET
  AFVENTER
  PROBLEM
}

enum NotificationType {
  OPGAVE
  TRAILER
  DRIVE_IN
  PROBLEM
  SYSTEM
}

enum NoteTargetType {
  TASK
  TRAILER
  CUSTOMER
  GENERAL
}

enum Shift {
  DAGHOLD
  NATHOLD
  ANDRE
}

enum BriefingRole {
  USER
  ASSISTANT
}

enum EndOfDayDecision {
  CARRIED_OVER
  NOT_NEEDED
  CLOSED_ANYWAY
}

// ─────────────────────────────────────────────────────────────
// CORE
// ─────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String   @default("MEDARBEJDER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks         Task[]
  templates     TaskTemplate[]
  trailerWashes TrailerWash[]
  driveInVisits DriveInVisit[]
  notes         Note[]
  notifications Notification[]
  categories    Category[]
  dailyActivity DailyActivity[]
  quantityLog   QuantityLogEntry[]
  briefings     DailyBriefing[]
  workSessions  WorkSession[]
  wageSettings  WageSettings?
}

model Category {
  id        String   @id @default(cuid())
  name      String
  icon      String   @default("📦")
  color     String   @default("#64748b")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  deletedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  tasks     Task[]
  templates TaskTemplate[]

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// TASKS
// ─────────────────────────────────────────────────────────────

model TaskTemplate {
  id             String         @id @default(cuid())
  title          String
  description    String?
  priority       Priority       @default(NORMAL)
  recurrenceType RecurrenceType
  weekdays       Int[]          @default([]) // 0=søn..6=lør, for UGEDAGE/HVERDAGE
  dayOfMonth     Int?
  specificDate   DateTime?
  intervalWeeks  Int?           @default(1) // for HVER_2_UGE
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  userId     String
  user       User      @relation(fields: [userId], references: [id])
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  checklistItems TaskTemplateChecklistItem[]
  generatedTasks Task[]

  @@index([userId])
}

model TaskTemplateChecklistItem {
  id         String       @id @default(cuid())
  title      String
  order      Int          @default(0)
  templateId String
  template   TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  priority    Priority  @default(NORMAL)
  order       Int       @default(0)
  dueDate     DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  startedAt   DateTime?
  scheduledFor DateTime @default(now()) // the day this task belongs to
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  cancelledAt DateTime?

  // Quantity-based work items (from briefings), e.g. "8 vaske", "3 juletræer"
  isQuantityTask Boolean @default(false)
  quantityTotal  Int?
  quantityDone   Int?    @default(0)
  quantityUnit   String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  templateId String?
  template   TaskTemplate? @relation(fields: [templateId], references: [id])

  sourceBriefingId String?
  sourceBriefing   DailyBriefing? @relation(fields: [sourceBriefingId], references: [id])

  carriedOverFromId String? @unique
  carriedOverFrom   Task?   @relation("CarryOver", fields: [carriedOverFromId], references: [id])
  carriedOverTo     Task?   @relation("CarryOver")

  checklistItems TaskChecklistItem[]
  notes          Note[]
  quantityLog    QuantityLogEntry[]

  @@index([userId, scheduledFor])
  @@index([templateId])
  @@index([sourceBriefingId])
}

model QuantityLogEntry {
  id        String   @id @default(cuid())
  delta     Int
  shift     Shift    @default(DAGHOLD)
  shiftLabel String?
  note      String?
  createdAt DateTime @default(now())

  // Optional per-unit registration detail (e.g. a single "vask fra haven"):
  // which trailer, which company, and its seal/plombe number (DFDS only).
  trailerNumber String?
  company       String?
  plombeNumber  String?

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([taskId])
}

// ─────────────────────────────────────────────────────────────
// GODMORGEN-BRIEFING / ARBEJDSASSISTENT
// ─────────────────────────────────────────────────────────────

model DailyBriefing {
  id       String   @id @default(cuid())
  date     DateTime // truncated to day

  plannedSummary       Json?    // frozen snapshot of the plan as first understood
  pendingConfirmation  Json?    // action list awaiting user confirmation
  pendingClarification Json?    // { question, pendingAction } awaiting a short reply

  closedAt       DateTime?
  closedSummary  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  messages BriefingMessage[]
  tasks    Task[]

  @@unique([userId, date])
}

model BriefingMessage {
  id        String       @id @default(cuid())
  role      BriefingRole
  text      String
  createdAt DateTime     @default(now())

  briefingId String
  briefing   DailyBriefing @relation(fields: [briefingId], references: [id], onDelete: Cascade)

  @@index([briefingId])
}

model TaskChecklistItem {
  id        String   @id @default(cuid())
  title     String
  completed Boolean  @default(false)
  order     Int      @default(0)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────
// TRAILERS / VASK
// ─────────────────────────────────────────────────────────────

model Trailer {
  id           String        @id @default(cuid())
  number       String        @unique
  licensePlate String?
  type         String?
  note         String?
  status       TrailerStatus @default(MANGLER)
  company      String? // DFDS or DSV — the only companies with trailers from the yard
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  washes TrailerWash[]
  notes  Note[]

  @@index([status])
}

model TrailerWash {
  id        String   @id @default(cuid())
  washedAt  DateTime @default(now())
  note      String?
  createdAt DateTime @default(now())

  // Company that owns the trailer, and its seal/plombe number (DFDS only) —
  // mirrors QuantityLogEntry's wash-registration fields.
  company      String?
  plombeNumber String?

  trailerId String
  trailer   Trailer @relation(fields: [trailerId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([trailerId])
}

// ─────────────────────────────────────────────────────────────
// DRIVE-IN / KUNDER
// ─────────────────────────────────────────────────────────────

model Company {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  customers DriveInCustomer[]
  visits    DriveInVisit[]
}

model DriveInCustomer {
  id                 String   @id @default(cuid())
  licensePlate       String   @unique // normalized, e.g. AB12345
  licensePlateDisplay String  // pretty format, e.g. AB 12 345
  createdAt          DateTime @default(now())

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  visits DriveInVisit[]
  notes  Note[]

  @@index([licensePlate])
}

model DriveInVisit {
  id           String   @id @default(cuid())
  refNumber    String?
  visitType    String?
  service      String?
  note         String?
  visitedAt    DateTime @default(now())
  createdAt    DateTime @default(now())

  customerId String
  customer   DriveInCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([customerId])
  @@index([visitedAt])
}

// ─────────────────────────────────────────────────────────────
// NOTES / PROBLEMS
// ─────────────────────────────────────────────────────────────

model Note {
  id         String         @id @default(cuid())
  text       String
  targetType NoteTargetType @default(GENERAL)
  isProblem  Boolean        @default(false)
  resolved   Boolean        @default(false)
  resolvedAt DateTime?
  createdAt  DateTime       @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id])

  trailerId String?
  trailer   Trailer? @relation(fields: [trailerId], references: [id])

  customerId String?
  customer   DriveInCustomer? @relation(fields: [customerId], references: [id])

  @@index([isProblem, resolved])
}

// ─────────────────────────────────────────────────────────────
// NOTIFICATIONS / ACTIVITY
// ─────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, read])
}

model DailyActivity {
  id     String   @id @default(cuid())
  date   DateTime // truncated to day
  summary Json     // { tasksCompleted, tasksTotal, washes, driveIns, problems }

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

// ─────────────────────────────────────────────────────────────
// LØN / TIDSREGISTRERING
// ─────────────────────────────────────────────────────────────

// Personlige lønregler — bruges af src/lib/wage/engine.ts til at beregne
// brutto/netto løn live ud fra tjek-ind/tjek-ud-tidspunkter.
model WageSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  hourlyRate             Float @default(150) // kr/time, grundløn
  overtimeThresholdHours Float @default(37) // timer/uge før overtid
  overtimeBonusPct       Float @default(0.6) // ekstra % af grundløn i overtid
  nightSupplement        Float @default(25) // kr/time tillæg i nattetimer
  nightStartHour         Int   @default(17) // nattillæg fra kl.
  nightEndHour           Int   @default(5) // nattillæg til kl.
  breakStartMinutes      Int   @default(720) // ulønnet pause fra (minutter efter midnat), 720 = 12:00
  breakEndMinutes        Int   @default(750) // ulønnet pause til, 750 = 12:30
  monthlyTaxDeduction    Float @default(5100) // skattefradrag pr. lønperiode
  amBidragPct            Float @default(0.08) // AM-bidrag
  taxRatePct             Float @default(0.44) // skatteprocent

  // Nuværende lønperiode — skattefradraget spores på tværs af denne periode,
  // ikke kalendermåneden (lønperioder følger ikke nødvendigvis 1.-sidste).
  // Opdateres manuelt her i indstillinger når en ny periode starter.
  payPeriodStart DateTime @default("2026-08-24T00:00:00.000Z")
  payPeriodEnd   DateTime @default("2026-09-20T00:00:00.000Z")

  updatedAt DateTime @updatedAt
}

model WorkSession {
  id            String    @id @default(cuid())
  checkInAt     DateTime
  checkOutAt    DateTime?
  paidSeconds   Int? // sat ved tjek-ud, ekskl. ulønnet pause
  grossAmount   Float? // sat ved tjek-ud, kr før skat
  netAmount     Float? // sat ved tjek-ud, kr efter skat
  // true for en uge indtastet bagudrettet (kun antal timer, ingen tjek-ind/ud) —
  // fx til at bygge bro over perioden før tjek-ind/ud-funktionen fandtes.
  isManualEntry Boolean   @default(false)
  createdAt     DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, checkInAt])
}
